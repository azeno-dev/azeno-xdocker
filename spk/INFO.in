package="xdocker"
version="@VERSION@"
os_min_ver="7.2-64570"
displayname="xDocker"
description="Manage Docker containers, images, stacks, ports and a private registry. Search and bulk-delete images, and clean up old images automatically (e.g. keep one per month)."
maintainer="@MAINTAINER@"
maintainer_url="@HOMEPAGE@"
support_url="@HOMEPAGE@"
arch="x86_64"
install_dep_packages="ContainerManager"
dsmuidir="ui"
dsmappname="SYNO.SDS.xdocker"
adminport="8790"
adminprotocol="http"
adminurl="/"
thirdparty="yes"
startable="yes"
ctl_stop="yes"
silent_upgrade="yes"
beta="yes"
